#!/usr/bin/env bash
# Lint and format check before every commit. Enabled by shell.nix.
set -euo pipefail

# Outside the dev shell (no direnv), rerun inside it
if ! command -v nixfmt >/dev/null; then
	exec nix-shell --run "$0"
fi

shfmt -d scripts/ .githooks/
shellcheck scripts/*.sh .githooks/pre-commit
nixfmt --check ./*.nix
