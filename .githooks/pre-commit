#!/usr/bin/env bash
# Lint and format check before every commit. Enabled by the flake dev shell.
set -euo pipefail

# Outside the dev shell (no direnv), rerun inside it
if ! command -v nixfmt >/dev/null; then
	exec nix develop --command "$0"
fi

shfmt -d modules/rice/scripts/ .githooks/
shellcheck modules/rice/scripts/*.sh .githooks/pre-commit
git ls-files -z "*.nix" | xargs -0 nixfmt --check
